+// Copyright (c) 2026 ttldtor. SPDX-License-Identifier: BSL-1.0
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <numbers>
+#include <string_view>
+
+namespace wasm_gallery {
+/** @brief Experimental tuning values; times use the host's monotonic millisecond clock. */
+struct MotoConfig {
+  double settleMs{250};              ///< Post-release impulse rejection interval.
+  double stableMs{600};              ///< Minimum uninterrupted stable sample duration.
+  std::size_t stableSamples{10};     ///< Minimum distinct arrivals in that window.
+  double stableRangeDegrees{2};      ///< Maximum range on either calibration axis.
+  double stableRateDegrees{5};       ///< Maximum adjacent angular rate, degrees per second.
+  double sampleGapMs{150};           ///< Largest permitted calibration sample gap.
+  double staleMs{250};               ///< Freshness bound for racing and resuming.
+  double preparationTimeoutMs{5000}; ///< Time from release before preparation pauses.
+  double countdownMs{1500};          ///< Delay between calibration/resume and racing.
+  double smoothingMs{75};            ///< Time constant for both control axes.
+  double deadzoneDegrees{1.5};       ///< Neutral deadzone before normalized controls.
+  double steeringDegrees{25};        ///< Tilt reaching full steering.
+  double pedalDegrees{20};           ///< Tilt reaching full throttle or brake.
+  double physicsStepMs{1000.0 / 60}; ///< Fixed simulation step.
+  unsigned maxCatchupSteps{4};       ///< Maximum simulation work per host frame.
+  double maxSpeed{28};               ///< Forward speed limit in route metres per second.
+  double acceleration{9};            ///< Full throttle acceleration, metres per second squared.
+  double braking{18};                ///< Full brake deceleration, metres per second squared.
+  double roadHalfWidth{4};           ///< Drivable half width in world metres.
+};
+
+/** @brief Values are part of the sample's JavaScript/WASM ABI. */
+enum class MotoState {
+  READY = 0,
+  HELD = 1,
+  SETTLING = 2,
+  COLLECTING = 3,
+  COUNTDOWN = 4,
+  RACING = 5,
+  PAUSED = 6
+};
+
+/** @brief Values are part of the sample's JavaScript/WASM ABI. */
+enum class MotoAction {
+  PRESS = 0,
+  RELEASE = 1,
+  CANCEL = 2,
+  PAUSE = 3,
+  CONTINUE = 4,
+  RECALIBRATE = 5,
+  RESTART = 6
+};
+
+/** @brief Indexed route generation; a bounded cache never retains the route's history. */
+class MotoTrack {
+public:
+  static constexpr std::size_t CAPACITY = 96;      ///< Fixed resident segment count, independent of race duration.
+  static constexpr double SEGMENT_METRES = 4;      ///< Distance between cached route samples, metres.
+  static constexpr unsigned GENERATOR_VERSION = 1; ///< Identifies the indexed hash and interpolation contract.
+
+  /** @param seed All 32 bits identify the versioned route. */
+  explicit MotoTrack(std::uint32_t seed = 1) noexcept : seed_(seed) {
+    refresh(0);
+  }
+
+  /** @param seed New route identity; discard the old cache and return to its beginning. */
+  void reset(std::uint32_t seed) noexcept {
+    seed_ = seed;
+    first_ = 0;
+    initialized_ = false;
+    refresh(0);
+  }
+
+  /** @param distance Finite nonnegative route distance in metres.
+   * Work is bounded by CAPACITY even after an arbitrary seek.
+   */
+  void refresh(double distance) noexcept {
+    const auto next = static_cast<std::uint64_t>(std::max(0.0, std::floor(distance / SEGMENT_METRES) - 4));
+
+    if (!initialized_ || next < first_ || next - first_ >= CAPACITY) {
+      for (std::size_t offset = 0; offset < CAPACITY; ++offset) {
+        store(next + offset);
+      }
+    } else {
+      for (auto index = first_ + CAPACITY; index < next + CAPACITY; ++index) {
+        store(index);
+      }
+    }
+
+    first_ = next;
+    initialized_ = true;
+  }
+
+  /** @param distance Finite nonnegative route distance in metres.
+   * @return Smooth road centre in world metres, independent of cache/viewport/FPS.
+   */
+  double centerAt(double distance) const noexcept {
+    const double position = std::max(0.0, distance) / ANCHOR_METRES;
+    const auto index = static_cast<std::uint64_t>(std::floor(position));
+    const double t = position - static_cast<double>(index);
+    const double blend = t * t * t * (t * (t * 6 - 15) + 10);
+
+    return anchor(index) + (anchor(index + 1) - anchor(index)) * blend;
+  }
+
+  /** @param index Absolute segment index.
+   * @return Cached centre if resident, otherwise the same stateless indexed result.
+   */
+  double segmentCenter(std::uint64_t index) const noexcept {
+    if (index >= first_ && index - first_ < CAPACITY) {
+      return centers_[index % CAPACITY];
+    }
+
+    return centerAt(static_cast<double>(index) * SEGMENT_METRES);
+  }
+
+  /** @return Oldest cached absolute segment index. */
+  std::uint64_t firstIndex() const noexcept {
+    return first_;
+  }
+
+  /** @return Fixed number of retained segment values. */
+  std::size_t storedSegments() const noexcept {
+    return centers_.size();
+  }
+
+  /** @return Current route seed. */
+  std::uint32_t seed() const noexcept {
+    return seed_;
+  }
+
+private:
+  static constexpr double ANCHOR_METRES = 64;
+  static constexpr double CENTER_AMPLITUDE = 4;
+
+  static std::uint32_t mix(std::uint32_t value) noexcept {
+    value ^= value >> 16;
+    value *= 0x7feb352dU;
+    value ^= value >> 15;
+    value *= 0x846ca68bU;
+    value ^= value >> 16;
+
+    return value;
+  }
+
+  double anchor(std::uint64_t index) const noexcept {
+    const auto value = mix(seed_ ^ mix(static_cast<std::uint32_t>(index)) ^ mix(static_cast<std::uint32_t>(index >> 32) + 0x9e3779b9U));
+
+    return (static_cast<double>(value) / 4294967295.0 * 2 - 1) * CENTER_AMPLITUDE;
+  }
+
+  void store(std::uint64_t index) noexcept {
+    centers_[index % CAPACITY] = centerAt(static_cast<double>(index) * SEGMENT_METRES);
+  }
+
+  std::array<double, CAPACITY> centers_{};
+  std::uint32_t seed_{};
+  std::uint64_t first_{};
+  bool initialized_{};
+};
+
+/** @brief Owning, allocation-free control and race state, accessed only on the UI thread.
+ * Input methods do not call widgets, callbacks or transports. JS arrivals retain their original
+ * order. advance() is the only simulation entry; presentation consumes getters between steps.
+ */
+class MotoModel {
+public:
+  /** @param config Owning control and simulation settings; use nonnegative finite tuning values.
+   * @param seed Versioned procedural route identity.
+   */
+  explicit MotoModel(MotoConfig config = {}, std::uint32_t seed = 1) noexcept : config_(config), track_(seed) {
+  }
+
+  /** @param beta Device X rotation in finite radians.
+   * @param gamma Device Y rotation in finite radians.
+   * @param angle Screen orientation in degrees: 0, 90, 180 or 270.
+   * @param now Original JS arrival timestamp in monotonic milliseconds.
+   * Malformed or out-of-order input is ignored; no borrowed values survive.
+   */
+  void sample(double beta, double gamma, int angle, double now) noexcept {
+    if (!validTime(now) || !std::isfinite(beta) || !std::isfinite(gamma) || (angle != 0 && angle != 90 && angle != 180 && angle != 270) || (hasSample_ && now <= sampleAt_)) {
+      return;
+    }
+
+    const double previousAt = sampleAt_;
+    const bool hadSample = hasSample_;
+
+    if (hadSample && angle != angle_) {
+      neutralValid_ = false;
+      clearWindow();
+
+      if (state_ != MotoState::READY) {
+        pause("Screen turned; recalibrate");
+      }
+    }
+
+    beta_ = std::remainder(beta, TWO_PI);
+    gamma_ = std::remainder(gamma, TWO_PI);
+    angle_ = angle;
+    sampleAt_ = now;
+    hasSample_ = true;
+    sensorReady_ = true;
+    sensorState_ = 3;
+    now_ = std::max(now_, now);
+
+    if (state_ == MotoState::SETTLING && now >= collectAfter_) {
+      state_ = MotoState::COLLECTING;
+    }
+
+    if (state_ == MotoState::COLLECTING && !gasHeld_ && !brakeHeld_) {
+      collect(now);
+    }
+
+    if (neutralValid_) {
+      updateControls(hadSample ? now - previousAt : 0);
+    }
+  }
+
+  /** @param gas True while any pointer owns the gas zone.
+   * @param brake True while any pointer owns the brake zone.
+   * @param now Timestamp in the same clock domain as sample().
+   */
+  void controls(bool gas, bool brake, double now) noexcept {
+    if (!validTime(now)) {
+      return;
+    }
+
+    now_ = std::max(now_, now);
+    gasHeld_ = gas;
+    brakeHeld_ = brake;
+
+    if ((gas || brake) && (state_ == MotoState::SETTLING || state_ == MotoState::COLLECTING)) {
+      restartWindow(now);
+    }
+  }
+
+  /** @param action Validated intent from the host.
+   * @param now Monotonic timestamp, in milliseconds.
+   */
+  void action(MotoAction action, double now) noexcept {
+    if (!validTime(now)) {
+      return;
+    }
+
+    now_ = std::max(now_, now);
+
+    switch (action) {
+    case MotoAction::PRESS:
+      if (state_ == MotoState::READY) {
+        beginHold(MotoState::READY);
+      }
+
+      break;
+    case MotoAction::RECALIBRATE:
+      if (state_ == MotoState::PAUSED) {
+        beginHold(MotoState::PAUSED);
+      }
+
+      break;
+    case MotoAction::RELEASE:
+      if (state_ == MotoState::HELD) {
+        releasedAt_ = now;
+        restartWindow(now);
+      }
+
+      break;
+    case MotoAction::CANCEL:
+      if (state_ == MotoState::HELD || state_ == MotoState::SETTLING || state_ == MotoState::COLLECTING) {
+        state_ = holdOrigin_;
+        clearWindow();
+        message_ = state_ == MotoState::READY ? "Hold Start, then release" : "Paused";
+      }
+
+      break;
+    case MotoAction::PAUSE:
+      pause("Paused");
+
+      break;
+    case MotoAction::CONTINUE:
+      if (canResume(now)) {
+        beginCountdown(now);
+      }
+
+      break;
+    case MotoAction::RESTART:
+      restart();
+
+      break;
+    }
+  }
+
+  /** @param state Zero unavailable, one waiting, two paused.
+   * Clear prior freshness until an actual new sample arrives.
+   */
+  void sensorState(int state) noexcept {
+    if (state < 0 || state > 2) {
+      return;
+    }
+
+    sensorState_ = state;
+    sensorReady_ = false;
+    filtered_ = false;
+    clearHolds();
+
+    if (state_ != MotoState::READY) {
+      pause(state == 0 ? "Sensor unavailable" : state == 2 ? "Paused"
+                                                           : "Waiting for sensor");
+    }
+  }
+
+  /** @param seed New route seed, accepted only in READY. */
+  void seed(std::uint32_t seed) noexcept {
+    if (state_ == MotoState::READY) {
+      track_.reset(seed);
+    }
+  }
+
+  /** @param now Latest host frame time; monotonically nondecreasing, milliseconds.
+   * Executes bounded fixed steps. A long frame gap pauses instead of catching up forever.
+   */
+  void advance(double now) noexcept {
+    if (!validTime(now) || (hasTick_ && now < lastTick_)) {
+      return;
+    }
+
+    now_ = std::max(now_, now);
+    const double elapsed = hasTick_ ? now - lastTick_ : 0;
+
+    hasTick_ = true;
+    lastTick_ = now;
+    lastSteps_ = 0;
+
+    if ((state_ == MotoState::SETTLING || state_ == MotoState::COLLECTING) && now - releasedAt_ > config_.preparationTimeoutMs) {
+      pause("Not stable; recalibrate");
+    }
+
+    if (state_ != MotoState::COUNTDOWN && state_ != MotoState::RACING) {
+      return;
+    }
+
+    if (!fresh(now)) {
+      pause("Input stale; continue when ready");
+
+      return;
+    }
+
+    if (elapsed > config_.physicsStepMs * config_.maxCatchupSteps) {
+      pause("Frame gap; press Continue");
+
+      return;
+    }
+
+    if (state_ == MotoState::COUNTDOWN) {
+      if (now >= raceAt_) {
+        state_ = MotoState::RACING;
+        accumulatorMs_ = 0;
+        message_ = "Use the controls to steer and ride";
+      }
+
+      return;
+    }
+
+    accumulatorMs_ += elapsed;
+
+    while (accumulatorMs_ + 0.000001 >= config_.physicsStepMs && lastSteps_ < config_.maxCatchupSteps) {
+      simulate(config_.physicsStepMs / 1000);
+      accumulatorMs_ -= config_.physicsStepMs;
+      ++lastSteps_;
+    }
+  }
+
+  /** @param now Candidate resume timestamp, milliseconds.
+   * @return True only for a paused race with matching neutral, fresh sensor and released pedals.
+   */
+  bool canResume(double now) const noexcept {
+    return state_ == MotoState::PAUSED && neutralValid_ && neutralAngle_ == angle_ && fresh(now) && !gasHeld_ && !brakeHeld_;
+  }
+
+  /** @return Current ABI state. */
+  MotoState state() const noexcept {
+    return state_;
+  }
+
+  /** @return Current short presentation hint; static storage only. */
+  std::string_view message() const noexcept {
+    if (state_ == MotoState::READY && !sensorReady_) {
+      return sensorState_ == 0 ? "Sensor unavailable" : "Waiting for sensor";
+    }
+
+    return message_;
+  }
+
+  /** @return Forward speed in metres per second. */
+  double speed() const noexcept {
+    return speed_;
+  }
+
+  /** @return Absolute travelled distance in metres. */
+  double distance() const noexcept {
+    return distance_;
+  }
+
+  /** @return Signed lateral offset from the road centre in metres. */
+  double lateral() const noexcept {
+    return lateral_;
+  }
+
+  /** @return Normalized left/right command in [-1,1]. */
+  double steering() const noexcept {
+    return steering_;
+  }
+
+  /** @return Normalized gas in [0,1], with brake priority. */
+  double gas() const noexcept {
+    return brake() > 0 ? 0 : std::max(gasHeld_ ? 1.0 : 0.0, tiltGas_);
+  }
+
+  /** @return Normalized brake in [0,1]. */
+  double brake() const noexcept {
+    return std::max(brakeHeld_ ? 1.0 : 0.0, tiltBrake_);
+  }
+
+  /** @return Whether the calibration reference still matches the current axes. */
+  bool neutralValid() const noexcept {
+    return neutralValid_;
+  }
+
+  /** @return Stable window progress in [0,1]. */
+  double calibrationProgress() const noexcept {
+    return windowCount_ == 0 ? 0 : std::clamp((windowLastAt_ - windowFirstAt_) / config_.stableMs, 0.0, 1.0);
+  }
+
+  /** @return Last host frame's fixed simulation step count. */
+  unsigned lastSteps() const noexcept {
+    return lastSteps_;
+  }
+
+  /** @return Borrowed track cache, valid through this model's lifetime. */
+  const MotoTrack &track() const noexcept {
+    return track_;
+  }
+
+private:
+  static constexpr double TWO_PI = 2 * std::numbers::pi;
+  static constexpr double DEGREES = 180 / std::numbers::pi;
+  static constexpr std::size_t WINDOW_CAPACITY = 128;
+  static constexpr double MAX_DISTANCE = 1.0e12;
+
+  static bool validTime(double now) noexcept {
+    return std::isfinite(now) && now >= 0;
+  }
+
+  bool fresh(double now) const noexcept {
+    return validTime(now) && sensorReady_ && hasSample_ && now >= sampleAt_ && now - sampleAt_ <= config_.staleMs;
+  }
+
+  void clearHolds() noexcept {
+    gasHeld_ = false;
+    brakeHeld_ = false;
+  }
+
+  void clearWindow() noexcept {
+    windowCount_ = 0;
+    windowFirstAt_ = 0;
+    windowLastAt_ = 0;
+  }
+
+  void beginHold(MotoState origin) noexcept {
+    holdOrigin_ = origin;
+    state_ = MotoState::HELD;
+    clearWindow();
+    message_ = "Release Start; let controls settle";
+  }
+
+  void restartWindow(double now) noexcept {
+    clearWindow();
+    collectAfter_ = now + config_.settleMs;
+    state_ = MotoState::SETTLING;
+    message_ = "Let the press settle; hold still";
+  }
+
+  void collect(double now) noexcept {
+    const double candidateBeta = windowCount_ == 0 ? beta_ : windowAnchorBeta_ + std::remainder(beta_ - windowAnchorBeta_, TWO_PI);
+    const double candidateGamma = windowCount_ == 0 ? gamma_ : windowAnchorGamma_ + std::remainder(gamma_ - windowAnchorGamma_, TWO_PI);
+
+    if (windowCount_ == 0) {
+      windowAnchorBeta_ = beta_;
+      windowAnchorGamma_ = gamma_;
+      windowMinBeta_ = windowMaxBeta_ = candidateBeta;
+      windowMinGamma_ = windowMaxGamma_ = candidateGamma;
+      windowFirstAt_ = now;
+      windowSumBeta_ = 0;
+      windowSumGamma_ = 0;
+    } else {
+      const double gap = now - windowLastAt_;
+      const double rate = std::max(std::abs(candidateBeta - windowLastBeta_), std::abs(candidateGamma - windowLastGamma_)) * DEGREES * 1000 / gap;
+      const double range = std::max(std::max(windowMaxBeta_, candidateBeta) - std::min(windowMinBeta_, candidateBeta),
+                                    std::max(windowMaxGamma_, candidateGamma) - std::min(windowMinGamma_, candidateGamma))
+        * DEGREES;
+
+      if (gap > config_.sampleGapMs || rate > config_.stableRateDegrees || range > config_.stableRangeDegrees || windowCount_ >= WINDOW_CAPACITY) {
+        restartWindow(now);
+
+        return;
+      }
+    }
+
+    windowMinBeta_ = std::min(windowMinBeta_, candidateBeta);
+    windowMaxBeta_ = std::max(windowMaxBeta_, candidateBeta);
+    windowMinGamma_ = std::min(windowMinGamma_, candidateGamma);
+    windowMaxGamma_ = std::max(windowMaxGamma_, candidateGamma);
+    windowLastBeta_ = candidateBeta;
+    windowLastGamma_ = candidateGamma;
+    windowLastAt_ = now;
+    windowSumBeta_ += candidateBeta;
+    windowSumGamma_ += candidateGamma;
+    ++windowCount_;
+    message_ = "Measuring a stable neutral pose";
+
+    if (windowCount_ >= std::max<std::size_t>(3, config_.stableSamples) && now - windowFirstAt_ >= config_.stableMs) {
+      // The strict range/rate checks reject motion; trimming the two extremes limits small outliers.
+      const double retainedCount = static_cast<double>(windowCount_ - 2);
+
+      neutralBeta_ = std::remainder((windowSumBeta_ - windowMinBeta_ - windowMaxBeta_) / retainedCount, TWO_PI);
+      neutralGamma_ = std::remainder((windowSumGamma_ - windowMinGamma_ - windowMaxGamma_) / retainedCount, TWO_PI);
+      neutralAngle_ = angle_;
+      neutralValid_ = true;
+      beginCountdown(now);
+    }
+  }
+
+  static double command(double degrees, double fullScale, double deadzone) noexcept {
+    const double magnitude = std::abs(degrees);
+
+    if (magnitude <= deadzone) {
+      return 0;
+    }
+
+    return std::copysign(std::clamp((magnitude - deadzone) / (fullScale - deadzone), 0.0, 1.0), degrees);
+  }
+
+  void updateControls(double dt) noexcept {
+    const double deviceX = std::remainder(gamma_ - neutralGamma_, TWO_PI) * DEGREES;
+    const double deviceY = std::remainder(beta_ - neutralBeta_, TWO_PI) * DEGREES;
+    double x = deviceX;
+    double y = deviceY;
+
+    if (angle_ == 90) {
+      x = deviceY;
+      y = -deviceX;
+    } else if (angle_ == 180) {
+      x = -deviceX;
+      y = -deviceY;
+    } else if (angle_ == 270) {
+      x = -deviceY;
+      y = deviceX;
+    }
+
+    const double weight = !filtered_ || dt <= 0 ? 1 : 1 - std::exp(-dt / config_.smoothingMs);
+
+    filteredX_ += weight * (x - filteredX_);
+    filteredY_ += weight * (y - filteredY_);
+    filtered_ = true;
+    steering_ = command(filteredX_, config_.steeringDegrees, config_.deadzoneDegrees);
+    const double pedal = command(filteredY_, config_.pedalDegrees, config_.deadzoneDegrees);
+
+    tiltGas_ = std::max(0.0, pedal);
+    tiltBrake_ = std::max(0.0, -pedal);
+  }
+
+  void beginCountdown(double now) noexcept {
+    clearHolds();
+    state_ = MotoState::COUNTDOWN;
+    raceAt_ = now + config_.countdownMs;
+    accumulatorMs_ = 0;
+    filtered_ = false;
+    filteredX_ = filteredY_ = 0;
+    steering_ = tiltGas_ = tiltBrake_ = 0;
+    message_ = "Neutral locked; get ready";
+  }
+
+  void pause(std::string_view message) noexcept {
+    state_ = MotoState::PAUSED;
+    clearHolds();
+    clearWindow();
+    accumulatorMs_ = 0;
+    filtered_ = false;
+    steering_ = tiltGas_ = tiltBrake_ = 0;
+    message_ = message;
+  }
+
+  void restart() noexcept {
+    state_ = MotoState::READY;
+    clearHolds();
+    clearWindow();
+    neutralValid_ = false;
+    filtered_ = false;
+    steering_ = tiltGas_ = tiltBrake_ = 0;
+    speed_ = distance_ = lateral_ = accumulatorMs_ = 0;
+    track_.reset(track_.seed());
+    message_ = "Hold Start, then release";
+  }
+
+  void simulate(double seconds) noexcept {
+    const double oldCenter = track_.centerAt(distance_);
+    const double drag = 0.6 + speed_ * 0.04;
+
+    speed_ = std::clamp(speed_ + (gas() * config_.acceleration - brake() * config_.braking - drag) * seconds, 0.0, config_.maxSpeed);
+    distance_ = std::min(MAX_DISTANCE, distance_ + speed_ * seconds);
+    lateral_ += steering_ * (2 + speed_ * 0.2) * seconds - (track_.centerAt(distance_) - oldCenter);
+    lateral_ = std::clamp(lateral_, -config_.roadHalfWidth * 2, config_.roadHalfWidth * 2);
+
+    if (std::abs(lateral_) > config_.roadHalfWidth) {
+      speed_ = std::max(0.0, speed_ - config_.braking * seconds * 0.4);
+    }
+
+    track_.refresh(distance_);
+  }
+
+  MotoConfig config_;
+  MotoTrack track_;
+  MotoState state_{MotoState::READY};
+  MotoState holdOrigin_{MotoState::READY};
+  std::string_view message_{"Hold Start, then release"};
+  double now_{}, sampleAt_{}, lastTick_{}, releasedAt_{}, collectAfter_{}, raceAt_{};
+  double beta_{}, gamma_{}, neutralBeta_{}, neutralGamma_{}, filteredX_{}, filteredY_{};
+  double steering_{}, tiltGas_{}, tiltBrake_{}, speed_{}, distance_{}, lateral_{}, accumulatorMs_{};
+  double windowAnchorBeta_{}, windowAnchorGamma_{}, windowMinBeta_{}, windowMaxBeta_{}, windowMinGamma_{}, windowMaxGamma_{};
+  double windowFirstAt_{}, windowLastAt_{}, windowLastBeta_{}, windowLastGamma_{}, windowSumBeta_{}, windowSumGamma_{};
+  std::size_t windowCount_{};
+  unsigned lastSteps_{};
+  int angle_{}, neutralAngle_{}, sensorState_{1};
+  bool gasHeld_{}, brakeHeld_{}, hasSample_{}, hasTick_{}, sensorReady_{}, neutralValid_{}, filtered_{};
+};
