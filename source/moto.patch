+// Copyright (c) 2026 ttldtor. SPDX-License-Identifier: BSL-1.0
+#pragma once
+
+#include "../gallery/settings.hpp"
+#include "moto_model.hpp"
+#include "sample_theme.hpp"
+#include <array>
+#include <format>
+#include <string>
+
+namespace wasm_gallery {
+/** @brief Stationary fluent Moto scene; host input never mutates widgets or runtime lifecycle. */
+class MotoScene {
+public:
+  /** @param options Borrowed settings, alive through scene destruction.
+   * @param theme Borrowed shared preset index, alive through scene destruction.
+   */
+  MotoScene(portals::ui::OptionsRef<example::Options> options, std::size_t &theme)
+      : theme_(theme), scene_(portals::ui::scene([this](portals::ManagedScene &, portals::Application &) {
+          return recipe();
+        })) {
+    using namespace portals;
+
+    scene_.applicationOptions([options] {
+      ApplicationOptions result;
+
+      result.writer.colorMode = options.get().ansi16 ? ColorMode::ANSI16 : ColorMode::TRUE_COLOR;
+      // The runtime rounds to whole milliseconds: a 17 ms cap permits every second 60 Hz host tick.
+      result.framesPerSecond = PRESENTATION_FPS_CAP;
+
+      return result;
+    });
+    scene_.configure([this](ManagedScene &owner, Application &app) {
+      owner_ = &owner;
+      app_ = &app;
+      applyTheme();
+
+      const AxisSize fixed{.preferred = 1, .mode = SizeMode::FIXED};
+      GridOptions grid;
+
+      grid.columns = {AxisSize{.mode = SizeMode::FLEX}};
+      grid.rows = {fixed, AxisSize{.mode = SizeMode::FLEX}};
+      grid.cells = {{title_.node().id(), 0, 0}, {body_.node().id(), 1, 0}};
+      example::take(setGridOptions(app.tree(), grid_.node(), grid));
+      example::take(app.router().setFocus(themeButton_.node()));
+      paint();
+    });
+    scene_.onKey("F2", [this] {
+      changeTheme();
+    });
+    scene_.onKey("F10 | Ctrl+C", ui::quit);
+  }
+
+  MotoScene(const MotoScene &) = delete;
+  MotoScene &operator=(const MotoScene &) = delete;
+  MotoScene(MotoScene &&) = delete;
+  MotoScene &operator=(MotoScene &&) = delete;
+
+  /** @return Borrowed facade, valid while this scene owner is alive. */
+  portals::ui::Scene &scene() noexcept {
+    return scene_;
+  }
+
+  /** @param beta Device pitch in radians.
+   * @param gamma Device roll in radians.
+   * @param angle Quarter-turn screen angle in degrees.
+   * @param now JS receive time in monotonic milliseconds.
+   */
+  void sample(double beta, double gamma, int angle, double now) noexcept {
+    model_.sample(beta, gamma, angle, now);
+  }
+
+  /** @param gas Whether the host gas zone is held.
+   * @param brake Whether the host brake zone is held.
+   * @param now JS event time in monotonic milliseconds.
+   */
+  void controls(bool gas, bool brake, double now) noexcept {
+    model_.controls(gas, brake, now);
+  }
+
+  /** @param action Validated host intent.
+   * @param now JS event time in monotonic milliseconds.
+   */
+  void action(MotoAction action, double now) noexcept {
+    model_.action(action, now);
+  }
+
+  /** @param now Latest host frame time in monotonic milliseconds; retained until beforeStep. */
+  void tick(double now) noexcept {
+    if (std::isfinite(now) && now >= tickAt_) {
+      tickAt_ = now;
+    }
+  }
+
+  /** @param state Zero unavailable, one waiting, two paused. */
+  void sensorState(int state) noexcept {
+    model_.sensorState(state);
+  }
+
+  /** @param seed Versioned 32-bit route identity, accepted only while READY. */
+  void seed(std::uint32_t seed) noexcept {
+    model_.seed(seed);
+  }
+
+  /** @return Current host ABI state. */
+  int state() const noexcept {
+    return static_cast<int>(model_.state());
+  }
+
+  /** @return Whether Continue is valid at the last retained host clock time. */
+  bool canResume() const noexcept {
+    return model_.canResume(tickAt_);
+  }
+
+  /** @brief Advance the owning model and update labels outside runtime callbacks/frames. */
+  void beforeStep() {
+    model_.advance(tickAt_);
+
+    if (app_) {
+      // The existing runtime owns the frame cap; cached labels avoid idle invalidation.
+      paint();
+    }
+  }
+
+private:
+  static constexpr std::uint32_t PRESENTATION_FPS_CAP = 60;
+  static constexpr int ROAD_COLUMNS = 30;
+  static constexpr int ROAD_ROWS = 12;
+  static constexpr double LOOKAHEAD_METRES = 96;
+  static constexpr double NEAR_METRES = 3;
+  static constexpr double HORIZON_COLUMNS = 4;
+  static constexpr double NEAR_COLUMNS = 26;
+  static constexpr double ROAD_METRES = 8;
+  static constexpr double DASH_PERIOD_METRES = 12;
+  static constexpr double DASH_LENGTH_METRES = 6;
+
+  portals::ui::Description<portals::Grid> recipe() {
+    using namespace portals;
+
+    auto actions = ui::hbox(
+      ui::button(themeButton_, "Theme F2", [this] {
+        changeTheme();
+      }),
+      ui::button("Quit F10", [] {
+        ui::quit();
+      }));
+    auto road = ui::vbox(
+      ui::label(road_[0], ""), ui::label(road_[1], ""), ui::label(road_[2], ""),
+      ui::label(road_[3], ""), ui::label(road_[4], ""), ui::label(road_[5], ""),
+      ui::label(road_[6], ""), ui::label(road_[7], ""), ui::label(road_[8], ""),
+      ui::label(road_[9], ""), ui::label(road_[10], ""), ui::label(road_[11], ""));
+    auto body = ui::vbox(body_, std::move(actions), ui::label(hud_, ""),
+                         ui::label(seedLabel_, ""), std::move(road),
+                         ui::label(mode_, "READY"), ui::label(status_, ""));
+
+    return ui::grid(grid_, ui::label(title_, " Moto race").id("moto-title"), std::move(body));
+  }
+
+  void applyTheme() {
+    example::take(owner_->theme(sampleTheme(theme_, "moto-title")));
+  }
+
+  void changeTheme() {
+    theme_ = (theme_ + 1) % example::THEME_PRESETS.size();
+    applyTheme();
+  }
+
+  void setText(portals::ui::Ref<portals::Label> &label, std::string value, std::string &previous) {
+    value.resize(std::min(value.size(), static_cast<std::size_t>(ROAD_COLUMNS)));
+
+    if (value != previous) {
+      example::take(portals::setControlText(app_->tree(), label.node(), example::text(value, app_->widthPolicy())));
+      previous = std::move(value);
+    }
+  }
+
+  void paint() {
+    static constexpr std::array<std::string_view, 7> STATES{"READY", "HELD", "SETTLING", "COLLECTING", "COUNTDOWN", "RACING", "PAUSED"};
+
+    setText(hud_, std::format("{:3.0f} km/h    {:6.2f} km", model_.speed() * 3.6, model_.distance() / 1000), hudText_);
+    setText(seedLabel_, std::format("Seed {}  route v{}", model_.track().seed(), MotoTrack::GENERATOR_VERSION), seedText_);
+    setText(mode_, std::format("{}  {:3.0f}%", STATES[static_cast<std::size_t>(model_.state())], model_.calibrationProgress() * 100), modeText_);
+    setText(status_, std::string(model_.message()), statusText_);
+
+    const double currentCenter = model_.track().centerAt(model_.distance());
+
+    for (int row = 0; row < ROAD_ROWS; ++row) {
+      const double depth = static_cast<double>(row) / (ROAD_ROWS - 1);
+      const double ahead = LOOKAHEAD_METRES * (1 - depth) + NEAR_METRES;
+      const double width = HORIZON_COLUMNS + depth * (NEAR_COLUMNS - HORIZON_COLUMNS);
+      const double center = ROAD_COLUMNS / 2.0 + (model_.track().centerAt(model_.distance() + ahead) - currentCenter - model_.lateral()) * width / ROAD_METRES;
+      const int left = static_cast<int>(std::lround(center - width / 2));
+      const int right = static_cast<int>(std::lround(center + width / 2));
+      const int middle = static_cast<int>(std::lround(center));
+      std::string line(ROAD_COLUMNS, '.');
+
+      for (int column = 0; column < ROAD_COLUMNS; ++column) {
+        if (column > left && column < right) {
+          line[static_cast<std::size_t>(column)] = ' ';
+        }
+
+        if (column == left || column == right) {
+          line[static_cast<std::size_t>(column)] = '|';
+        } else if (column == middle && std::fmod(model_.distance() + ahead, DASH_PERIOD_METRES) < DASH_LENGTH_METRES) {
+          line[static_cast<std::size_t>(column)] = ':';
+        }
+      }
+
+      if (row == ROAD_ROWS - 2 || row == ROAD_ROWS - 1) {
+        line[ROAD_COLUMNS / 2] = row == ROAD_ROWS - 2 ? '^' : 'O';
+      }
+
+      setText(road_[static_cast<std::size_t>(row)], std::move(line), roadText_[static_cast<std::size_t>(row)]);
+    }
+  }
+
+  std::size_t &theme_;
+  MotoModel model_;
+  portals::ui::Ref<portals::Grid> grid_;
+  portals::ui::Ref<portals::Column> body_;
+  portals::ui::Ref<portals::Label> title_, hud_, seedLabel_, mode_, status_;
+  std::array<portals::ui::Ref<portals::Label>, ROAD_ROWS> road_;
+  portals::ui::Ref<portals::Button> themeButton_;
+  portals::ManagedScene *owner_{};
+  portals::Application *app_{};
+  std::string hudText_, seedText_, modeText_, statusText_;
+  std::array<std::string, ROAD_ROWS> roadText_;
+  double tickAt_{};
+  portals::ui::Scene scene_;
+};
