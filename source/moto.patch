+// Copyright (c) 2026 ttldtor. SPDX-License-Identifier: BSL-1.0
+// Built as portals_moto_model_tests; finite doctest scenarios require no UI or sensor.
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include "../../vendor/doctest/doctest.h"
+#include "moto_model.hpp"
+#include <limits>
+
+using namespace wasm_gallery;
+
+namespace {
+constexpr double RADIAN = std::numbers::pi / 180;
+
+void frames(MotoModel &model, int first, int last, double beta = 0, double gamma = 0, int angle = 0) {
+  for (int now = first; now <= last; now += 10) {
+    if (now % 50 == 0) {
+      model.sample(beta, gamma, angle, now);
+    }
+
+    model.advance(now);
+  }
+}
+
+void calibrated(MotoModel &model, double beta = 0, double gamma = 0, int angle = 0) {
+  model.sample(beta, gamma, angle, 0);
+  model.action(MotoAction::PRESS, 10);
+  model.action(MotoAction::RELEASE, 20);
+  frames(model, 30, 900, beta, gamma, angle);
+  REQUIRE(model.state() == MotoState::COUNTDOWN);
+  REQUIRE(model.neutralValid());
+}
+
+void racing(MotoModel &model, double beta = 0, double gamma = 0, int angle = 0) {
+  calibrated(model, beta, gamma, angle);
+  frames(model, 910, 2400, beta, gamma, angle);
+  REQUIRE(model.state() == MotoState::RACING);
+}
+} // namespace
+
+TEST_CASE("press impulse is excluded and a stable post-release window locks neutral") {
+  MotoModel model;
+
+  model.sample(0, 0, 0, 0);
+  model.action(MotoAction::PRESS, 10);
+  model.sample(50 * RADIAN, 40 * RADIAN, 0, 15);
+  frames(model, 20, 200, 50 * RADIAN, 40 * RADIAN);
+  CHECK(model.state() == MotoState::HELD);
+  CHECK_FALSE(model.neutralValid());
+  model.action(MotoAction::RELEASE, 210);
+  frames(model, 220, 1050);
+  CHECK(model.state() == MotoState::COLLECTING);
+  CHECK_FALSE(model.neutralValid());
+  frames(model, 1060, 1100);
+  CHECK(model.state() == MotoState::COUNTDOWN);
+  CHECK(model.neutralValid());
+  CHECK(model.steering() == doctest::Approx(0));
+  CHECK(model.gas() == doctest::Approx(0));
+}
+
+TEST_CASE("sparse arrivals and repeated timestamps cannot manufacture stable time") {
+  MotoModel model;
+
+  model.action(MotoAction::PRESS, 0);
+  model.action(MotoAction::RELEASE, 1);
+
+  for (int now = 300; now < 3000; now += 200) {
+    model.sample(0, 0, 0, now);
+    model.sample(0, 0, 0, now);
+    model.advance(now);
+  }
+
+  CHECK_FALSE(model.neutralValid());
+  CHECK(model.state() != MotoState::COUNTDOWN);
+}
+
+TEST_CASE("movement and held pedals restart the stable window") {
+  MotoModel model;
+
+  model.action(MotoAction::PRESS, 0);
+  model.action(MotoAction::RELEASE, 1);
+  frames(model, 10, 700);
+  REQUIRE(model.state() == MotoState::COLLECTING);
+  model.sample(10 * RADIAN, 0, 0, 710);
+  CHECK(model.state() == MotoState::SETTLING);
+  CHECK_FALSE(model.neutralValid());
+  frames(model, 720, 1200);
+  model.controls(true, false, 1210);
+  frames(model, 1220, 2000);
+  CHECK_FALSE(model.neutralValid());
+  model.controls(false, false, 2010);
+  frames(model, 2020, 2900);
+  CHECK(model.neutralValid());
+}
+
+TEST_CASE("a pedal held before Start remains held through preparation") {
+  MotoModel model;
+
+  model.controls(true, false, 0);
+  model.action(MotoAction::PRESS, 10);
+  model.action(MotoAction::RELEASE, 20);
+  frames(model, 30, 900);
+  CHECK_FALSE(model.neutralValid());
+  CHECK(model.state() != MotoState::COUNTDOWN);
+  model.controls(false, false, 910);
+  frames(model, 920, 1900);
+  CHECK(model.neutralValid());
+  CHECK(model.state() == MotoState::COUNTDOWN);
+}
+
+TEST_CASE("first-start interruption cannot resume without neutral") {
+  MotoModel model;
+
+  model.sample(0, 0, 0, 0);
+  model.action(MotoAction::PRESS, 10);
+  model.action(MotoAction::RELEASE, 20);
+  model.action(MotoAction::PAUSE, 100);
+  model.sample(0, 0, 0, 110);
+  CHECK_FALSE(model.canResume(110));
+  model.action(MotoAction::CONTINUE, 110);
+  CHECK(model.state() == MotoState::PAUSED);
+  model.action(MotoAction::RECALIBRATE, 120);
+  model.action(MotoAction::CANCEL, 130);
+  CHECK(model.state() == MotoState::PAUSED);
+  CHECK_FALSE(model.neutralValid());
+}
+
+TEST_CASE("pause clears holds and cancelled recalibration preserves the race") {
+  MotoModel model;
+
+  racing(model);
+  model.controls(true, false, 2401);
+  frames(model, 2410, 3000);
+  const double distance = model.distance();
+
+  REQUIRE(distance > 0);
+  model.action(MotoAction::PAUSE, 3001);
+  CHECK(model.gas() == 0);
+  model.action(MotoAction::RECALIBRATE, 3010);
+  model.sample(0, 0, 0, 3020);
+  model.action(MotoAction::CANCEL, 3030);
+  CHECK(model.state() == MotoState::PAUSED);
+  CHECK(model.distance() == distance);
+  CHECK(model.neutralValid());
+  CHECK(model.canResume(3030));
+  model.controls(true, false, 3031);
+  CHECK_FALSE(model.canResume(3031));
+  model.controls(false, false, 3032);
+  model.action(MotoAction::CONTINUE, 3032);
+  CHECK(model.state() == MotoState::COUNTDOWN);
+}
+
+TEST_CASE("neutral remains fixed while steering and wrap uses the short angular delta") {
+  MotoModel model;
+
+  racing(model, 179 * RADIAN, 0);
+  frames(model, 2410, 3500, -179 * RADIAN, 20 * RADIAN);
+  CHECK(model.state() == MotoState::RACING);
+  CHECK(model.steering() > 0.7);
+  CHECK(model.gas() < 0.1);
+  frames(model, 3510, 5000, 179 * RADIAN, 0);
+  CHECK(std::abs(model.steering()) < 0.001);
+  CHECK(model.neutralValid());
+}
+
+TEST_CASE("screen axes are compensated and rotating invalidates the old neutral") {
+  MotoModel model;
+
+  racing(model, 0, 0, 90);
+  frames(model, 2410, 3000, 20 * RADIAN, 0, 90);
+  CHECK(model.steering() > 0.7);
+  model.sample(0, 0, 180, 3010);
+  CHECK(model.state() == MotoState::PAUSED);
+  CHECK_FALSE(model.neutralValid());
+  CHECK_FALSE(model.canResume(3010));
+}
+
+TEST_CASE("stale sensor and long frames pause with bounded catch-up") {
+  MotoModel model;
+
+  racing(model);
+  model.controls(true, false, 2401);
+  frames(model, 2410, 2600);
+  model.advance(2851);
+  CHECK(model.state() == MotoState::PAUSED);
+  CHECK(model.gas() == 0);
+  CHECK(model.lastSteps() == 0);
+  model.sample(0, 0, 0, 2860);
+  CHECK(model.canResume(2860));
+  model.action(MotoAction::CONTINUE, 2860);
+  model.advance(2860);
+  model.sample(0, 0, 0, 4000);
+  model.advance(4000);
+  CHECK(model.state() == MotoState::PAUSED);
+  CHECK(model.lastSteps() == 0);
+}
+
+TEST_CASE("brake wins over touch gas and tilt gas") {
+  MotoModel model;
+
+  racing(model);
+  frames(model, 2410, 2800, 25 * RADIAN, 0);
+  REQUIRE(model.gas() > 0.9);
+  model.controls(true, true, 2801);
+  CHECK(model.gas() == 0);
+  CHECK(model.brake() == 1);
+  model.controls(true, false, 2802);
+  CHECK(model.gas() == 1);
+  model.controls(false, false, 2803);
+  CHECK(model.gas() > 0.9);
+}
+
+TEST_CASE("time-based smoothing gives the same response at 20 and 50 millisecond sample intervals") {
+  MotoModel fast, slow;
+
+  racing(fast);
+  racing(slow);
+
+  for (int now = 2420; now <= 2700; now += 20) {
+    fast.sample(0, 25 * RADIAN, 0, now);
+  }
+
+  for (int now = 2450; now <= 2700; now += 50) {
+    slow.sample(0, 25 * RADIAN, 0, now);
+  }
+
+  CHECK(fast.steering() > 0.97);
+  CHECK(fast.steering() == doctest::Approx(slow.steering()).epsilon(0.001));
+}
+
+TEST_CASE("malformed samples cannot create a calibration or alter valid controls") {
+  MotoModel model;
+
+  racing(model);
+  model.sample(std::numeric_limits<double>::quiet_NaN(), 1, 0, 2410);
+  model.sample(0, std::numeric_limits<double>::infinity(), 0, 2420);
+  model.sample(0, 0, 45, 2430);
+  model.sample(0, 0, 0, -1);
+  CHECK(model.steering() == 0);
+  CHECK(model.neutralValid());
+  CHECK(model.state() == MotoState::RACING);
+}
+
+TEST_CASE("route identity and smooth joins do not depend on cache or seed-setting time") {
+  MotoTrack first(1234), second(1234), other(4567);
+
+  for (int index = 0; index < 1000; ++index) {
+    first.refresh(index * 100);
+    CHECK(first.storedSegments() == MotoTrack::CAPACITY);
+  }
+
+  for (int index = 0; index < 100; ++index) {
+    const double distance = index * 23.75;
+
+    CHECK(first.centerAt(distance) == second.centerAt(distance));
+    CHECK(first.segmentCenter(index) == second.segmentCenter(index));
+  }
+
+  CHECK(first.centerAt(100) != other.centerAt(100));
+  const double center = first.centerAt(64);
+  const double leftRate = (center - first.centerAt(63.999)) / 0.001;
+  const double rightRate = (first.centerAt(64.001) - center) / 0.001;
+
+  CHECK(std::abs(leftRate - rightRate) < 0.00001);
+}
+
+TEST_CASE("restart preserves seed while resetting progress and allowing a new seed") {
+  MotoModel model({}, 42);
+
+  racing(model);
+  model.seed(100);
+  CHECK(model.track().seed() == 42);
+  model.controls(true, false, 2401);
+  frames(model, 2410, 3000);
+  REQUIRE(model.distance() > 0);
+  model.action(MotoAction::RESTART, 3010);
+  CHECK(model.state() == MotoState::READY);
+  CHECK(model.distance() == 0);
+  CHECK(model.speed() == 0);
+  CHECK_FALSE(model.neutralValid());
+  CHECK(model.track().seed() == 42);
+  model.seed(100);
+  CHECK(model.track().seed() == 100);
+}
