@@ -0,0 +1,26 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { resolve, extname, sep } from 'node:path';
+
+const root = resolve(process.env.PORTALS_WASM_DIR || 'build/wasm-debug/wasm-gallery');
+const port = Number(process.env.PORTALS_WASM_PORT || 41803);
+const types = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8', '.wasm': 'application/wasm', '.map': 'application/json' };
+const server = http.createServer(async (request, response) => {
+  const pathname = decodeURIComponent(new URL(request.url, `http://127.0.0.1:${port}`).pathname);
+  const file = resolve(root, '.' + (pathname === '/' ? '/index.html' : pathname));
+  if (!file.startsWith(root + sep)) { response.writeHead(403).end(); return; }
+  try {
+    const bytes = await readFile(file);
+    response.writeHead(200, { 'Content-Type': types[extname(file)] || 'application/octet-stream',
+      'Cache-Control': 'no-store' });
+    response.end(bytes);
+  } catch {
+    response.writeHead(404).end('Not found');
+  }
+});
+server.listen(port, '127.0.0.1', () => console.log(`Gallery: http://127.0.0.1:${port}`));
+process.on('SIGTERM', () => server.close(() => process.exit(0)));
+process.on('SIGINT', () => server.close(() => process.exit(0)));
