+private:
+  struct TargetBase {
+    virtual ~TargetBase() = default;
+    virtual R invoke(Args... args) = 0;
+  };
+
+  template <class F> struct Target final : TargetBase {
+    template <class Input> explicit Target(Input &&callable) : callable_(std::forward<Input>(callable)) {
+    }
