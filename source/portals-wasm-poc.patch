+import { build } from 'esbuild';
+import { copyFile, mkdir } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const output = resolve(process.argv[2] || resolve(here, '../../../build/wasm-debug/wasm-gallery'));
+await mkdir(output, { recursive: true });
+await build({ entryPoints: [resolve(here, 'main.js')], bundle: true, format: 'esm',
+  outfile: resolve(output, 'main.js'), external: ['./portals-gallery.js'], sourcemap: true });
+await copyFile(resolve(here, 'index.html'), resolve(output, 'index.html'));
+await copyFile(resolve(here, '../LICENSES.txt'), resolve(output, 'LICENSES.txt'));
+
+const notices = [
+  ['../../../LICENSE.txt', 'PORTALS-LICENSE.txt'],
+  ['../../../vendor/utf8proc/LICENSE.md', 'UTF8PROC-LICENSE.md'],
+  ['node_modules/@xterm/xterm/LICENSE', 'XTERM-LICENSE.txt'],
+  ['node_modules/@xterm/addon-fit/LICENSE', 'XTERM-FIT-LICENSE.txt']
+];
+for (const [source, destination] of notices) {
+  await copyFile(resolve(here, source), resolve(output, destination));
+}
