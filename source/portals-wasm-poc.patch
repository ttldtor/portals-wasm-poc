diff --git a/tests/move_only_function.cpp b/tests/move_only_function.cpp
new file mode 100644
index 0000000..e0151d2
--- /dev/null
+++ b/tests/move_only_function.cpp
@@ -0,0 +1,139 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+
+#include <portals/detail/move_only_function.hpp>
+#include <portals/ui.hpp>
+
+#ifdef __EMSCRIPTEN__
+#  include "../examples/gallery/fluent_form.hpp"
+#endif
+
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string_view>
+#include <type_traits>
+#include <utility>
+
+namespace {
+int failures = 0;
+
+static_assert(std::is_nothrow_move_assignable_v<portals::detail::BasicMoveOnlyFunction<int(int)>>);
+
+void check(bool condition, const char *message) {
+  if (!condition) {
+    std::cerr << message << '\n';
+    ++failures;
+  }
+}
+
+template <template <class> class Function> void exerciseCallable() {
+  static_assert(!std::is_copy_constructible_v<Function<int(int)>>);
+  static_assert(!std::is_copy_assignable_v<Function<int(int)>>);
+  static_assert(std::is_nothrow_move_constructible_v<Function<int(int)>>);
+  static_assert(std::is_move_assignable_v<Function<int(int)>>);
+
+  Function<void()> empty;
+  Function<void()> null = nullptr;
+  void (*nullPointer)() = nullptr;
+  Function<void()> fromNullPointer = nullPointer;
+
+  check(!empty && !null && !fromNullPointer, "default and null targets must be empty");
+
+  Function<int(int)> value = [owned = std::make_unique<int>(7)](int delta) mutable {
+    *owned += delta;
+
+    return *owned;
+  };
+
+  check(value(3) == 10 && value(2) == 12, "move-only capture retains mutable state and result");
+
+  Function<int(int)> moved = std::move(value);
+
+  check(!value && static_cast<bool>(moved), "move construction transfers target and empties source");
+  check(moved(1) == 13, "moved target retains capture state");
+
+  auto previous = std::make_shared<int>(0);
+  std::weak_ptr<int> previousObserver = previous;
+  Function<int(int)> assigned = [owned = std::move(previous)](int delta) {
+    return *owned + delta;
+  };
+
+  assigned = std::move(moved);
+  check(previousObserver.expired(), "move assignment releases previous captures");
+  check(!moved && static_cast<bool>(assigned), "move assignment transfers target and empties source");
+  check(assigned(1) == 14, "move-assigned target retains capture state");
+
+  auto lifetime = std::make_shared<int>(0);
+  std::weak_ptr<int> observer = lifetime;
+  Function<void()> released = [owned = std::move(lifetime)] {
+  };
+
+  check(!observer.expired(), "callable owns captured lifetime");
+  released = nullptr;
+  check(!released && observer.expired(), "null assignment releases target captures");
+
+  int result = 0;
+  Function<void(std::unique_ptr<int>, int &)> consume = [&result](std::unique_ptr<int> input, int &increment) {
+    result = *input + increment;
+    ++increment;
+
+    return 1;
+  };
+  int increment = 4;
+
+  consume(std::make_unique<int>(6), increment);
+  check(result == 10 && increment == 5, "void result discards return and forwards owning/reference arguments");
+
+  Function<int()> throwing = []() -> int {
+    throw std::runtime_error("callable failure");
+  };
+  bool caught = false;
+
+  try {
+    (void)throwing();
+  } catch (const std::runtime_error &error) {
+    caught = std::string_view(error.what()) == "callable failure";
+  }
+
+  check(caught && static_cast<bool>(throwing), "call exceptions propagate without clearing target");
+
+  auto destroyed = std::make_shared<int>(0);
+  std::weak_ptr<int> destroyedObserver = destroyed;
+
+  {
+    Function<void()> scoped = [owned = std::move(destroyed)] {
+    };
+
+    check(!destroyedObserver.expired(), "scoped callable owns capture");
+  }
+
+  check(destroyedObserver.expired(), "destruction releases target captures");
+}
+
+#if defined(__cpp_lib_move_only_function) && __cpp_lib_move_only_function >= 202110L
+static_assert(std::is_same_v<portals::detail::MoveOnlyFunction<void()>, std::move_only_function<void()>>);
+static_assert(std::is_same_v<portals::ui::Setup<portals::Widget>,
+                             std::move_only_function<std::expected<void, portals::ManagedError>(
+                               portals::ManagedScene &, portals::Node<portals::Widget>)>>);
+static_assert(
+  std::is_same_v<portals::ui::CommandLineParser,
+                 std::move_only_function<std::expected<portals::ui::LaunchAction, portals::ui::CommandLineError>(
+                   const portals::ui::app::Arguments &)>>);
+#else
+static_assert(
+  std::is_same_v<portals::detail::MoveOnlyFunction<void()>, portals::detail::BasicMoveOnlyFunction<void()>>);
+#endif
+} // namespace
+
+int main() {
+  exerciseCallable<portals::detail::BasicMoveOnlyFunction>();
+  exerciseCallable<portals::detail::MoveOnlyFunction>();
+
+#ifdef __EMSCRIPTEN__
+  example::Options options;
+  auto scene = gallery::form(portals::ui::opts(options));
+#endif
+
+  return failures == 0 ? 0 : 1;
+}
diff --git a/tests/runtime_session.cpp b/tests/runtime_session.cpp
new file mode 100644
index 0000000..38ca088
--- /dev/null
+++ b/tests/runtime_session.cpp
@@ -0,0 +1,310 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+#include "support/examples/replay/terminal.hpp"
+#include <algorithm>
+#include <deque>
+#include <limits>
+#include <portals/application.hpp>
+#include <source_location>
+#include <stdexcept>
+#include <thread>
+
+namespace {
+using namespace portals;
+
+void check(bool value, std::source_location where = std::source_location::current()) {
+  if (!value) {
+    throw std::runtime_error("runtime session check line " + std::to_string(where.line()));
+  }
+}
+
+template <class T, class E> T take(std::expected<T, E> value) {
+  check(bool(value));
+
+  if constexpr (!std::is_void_v<T>) {
+    return std::move(*value);
+  }
+}
+
+class ReadyTerminal final : public ApplicationReadyTerminal {
+public:
+  SchedulerClock clock() noexcept {
+    return {[](void *context) noexcept {
+              return static_cast<ReadyTerminal *>(context)->time;
+            },
+            this};
+  }
+
+  TerminalRead poll(std::stop_token) override {
+    ++polls;
+
+    if (input.empty()) {
+      return {TerminalStatus::DEADLINE};
+    }
+
+    auto batch = std::move(input.front());
+    input.pop_front();
+
+    return batch;
+  }
+
+  std::expected<CellSize, TerminalError> size() const override {
+    return CellSize{12, 3};
+  }
+
+  std::expected<void, TerminalError> submit(std::string bytes) override {
+    check(pending.empty());
+    ++submissions;
+    pending = std::move(bytes);
+
+    return {};
+  }
+
+  TerminalWrite flushReady(std::stop_token) override {
+    ++flushes;
+
+    if (failFlush) {
+      return {TerminalStatus::FAILED, 0, pending.size(), TerminalError{TerminalErrorKind::OUTPUT_UNCERTAIN, 91}};
+    }
+
+    const auto count = std::min(chunk, pending.size());
+    output.append(pending, 0, count);
+    pending.erase(0, count);
+
+    return {pending.empty() ? TerminalStatus::PROGRESS : TerminalStatus::DEADLINE, count, pending.size(), {}};
+  }
+
+  std::expected<void, TerminalError> close() noexcept override {
+    ++closes;
+
+    if (failClose) {
+      return std::unexpected(TerminalError{TerminalErrorKind::SYSTEM, 17});
+    }
+
+    return {};
+  }
+
+  void bytes(std::string value) {
+    input.push_back({TerminalStatus::PROGRESS, std::move(value)});
+  }
+
+  void eof() {
+    input.push_back({TerminalStatus::END_OF_INPUT});
+  }
+
+  SchedulerTime time{};
+  std::deque<TerminalRead> input;
+  std::string output, pending;
+  std::size_t chunk{std::numeric_limits<std::size_t>::max()}, polls{}, flushes{}, submissions{}, closes{};
+  bool failFlush{}, failClose{};
+};
+
+class Scene final : public ApplicationScene {
+public:
+  std::expected<bool, TreeError> input(Application &app, const InputEvent &event) override {
+    events.push_back(event);
+
+    if (reenter) {
+      auto nested = app.step();
+      check(!nested && std::get<ApplicationFailure>(nested.error().cause) == ApplicationFailure::REENTRANT_OPERATION);
+      ++rejections;
+    }
+
+    if (stopOnInput) {
+      app.requestStop();
+    }
+
+    take(app.tree().invalidate(app.root(), Invalidation::PAINT));
+
+    return true;
+  }
+
+  void stop(Application &) override {
+    ++stops;
+  }
+
+  std::vector<InputEvent> events;
+  std::size_t stops{}, rejections{};
+  bool stopOnInput{}, reenter{};
+};
+
+void idleAndLifecycle() {
+  ReadyTerminal terminal;
+  auto app = take(Application::create({}, terminal.clock()));
+  Scene scene;
+  check(!app->step());
+  take(app->start(scene, terminal));
+  auto idle = take(app->step());
+  check(!idle.finished && idle.stats.frames == 1 && terminal.polls == 1 && terminal.flushes == 1);
+  idle = take(app->step());
+  check(!idle.finished && idle.stats.frames == 1 && terminal.polls == 2 && terminal.flushes == 1);
+  check(!app->start(scene, terminal) && !app->run(scene));
+
+  std::thread wrong([&] {
+    auto rejected = app->step();
+    check(!rejected && std::get<TreeError>(rejected.error().cause) == TreeError::WRONG_THREAD);
+  });
+  wrong.join();
+  check(terminal.closes == 0 && scene.stops == 0);
+  app->requestStop();
+  auto stopped = take(app->step());
+  check(stopped.finished && terminal.closes == 1 && scene.stops == 1);
+  check(take(app->step()).finished && terminal.closes == 1 && scene.stops == 1);
+}
+
+void decoderAndBudget() {
+  ReadyTerminal terminal;
+  ApplicationOptions options;
+  options.scheduler.control_capacity = options.scheduler.control_budget = 1;
+  options.inputBudget = 2;
+  auto app = take(Application::create(options, terminal.clock()));
+  Scene scene;
+  take(app->start(scene, terminal));
+  terminal.bytes("abcdef");
+  take(app->step());
+  terminal.bytes("\xe7\x95");
+  terminal.bytes("\x8c");
+  terminal.bytes("\x1b");
+
+  for (std::size_t i = 0; i < 40; ++i) {
+    take(app->step());
+  }
+
+  terminal.time = 1000;
+  take(app->step());
+  terminal.eof();
+  bool done{};
+
+  for (std::size_t i = 0; i < 40 && !done; ++i) {
+    done = take(app->step()).finished;
+  }
+
+  check(done && scene.events.size() == 8 && terminal.closes == 1);
+  check(std::get<TextInputEvent>(scene.events[6]).scalar == U'界');
+  check(std::get<KeyEvent>(scene.events[7]).key == InputKey::ESCAPE);
+  check(app->scheduler().metrics().control.rejected > 0);
+}
+
+void frameCapAndEofCutoff() {
+  ReadyTerminal terminal;
+  auto app = take(Application::create({}, terminal.clock()));
+  Scene scene;
+  take(app->start(scene, terminal));
+  check(take(app->step()).stats.frames == 1);
+  terminal.time = 1;
+  terminal.bytes("x");
+  check(take(app->step()).stats.frames == 1);
+  terminal.time = 33;
+  check(take(app->step()).stats.frames == 1);
+  terminal.time = 34;
+  check(take(app->step()).stats.frames == 2);
+  terminal.time = 35;
+  terminal.bytes("y");
+  take(app->step());
+  terminal.eof();
+  auto ended = take(app->step());
+  check(ended.finished && ended.stats.frames == 2 && ended.stats.inputs == 2);
+}
+
+void partialAndFailures() {
+  ReadyTerminal terminal;
+  terminal.chunk = 2;
+  auto app = take(Application::create({}, terminal.clock()));
+  Scene scene;
+  take(app->start(scene, terminal));
+  auto first = take(app->step());
+  check(first.stats.bytes == 2 && !terminal.pending.empty());
+  terminal.eof();
+  bool done{};
+
+  for (std::size_t i = 0; i < 1000 && !done; ++i) {
+    done = take(app->step()).finished;
+  }
+
+  check(done && terminal.submissions == 1 && terminal.pending.empty() && terminal.closes == 1);
+  check(app->stats().bytes == terminal.output.size());
+
+  ReadyTerminal failed;
+  failed.failFlush = failed.failClose = true;
+  auto failing = take(Application::create({}, failed.clock()));
+  Scene failureScene;
+  take(failing->start(failureScene, failed));
+  auto error = failing->step();
+  check(!error && error.error().phase == ApplicationPhase::FLUSH && error.error().restoration);
+  check(std::get<TerminalError>(error.error().cause).kind == TerminalErrorKind::OUTPUT_UNCERTAIN);
+  check(!failing->step() && failed.flushes == 1 && failed.closes == 1 && failureScene.stops == 1);
+}
+
+void cancellationAndDestruction() {
+  ReadyTerminal terminal;
+  Scene scene;
+  {
+    auto app = take(Application::create({}, terminal.clock()));
+    take(app->start(scene, terminal));
+    take(app->step());
+  }
+  check(terminal.closes == 1 && scene.stops == 1);
+
+  ReadyTerminal cancelled;
+  auto app = take(Application::create({}, cancelled.clock()));
+  Scene cancelledScene;
+  std::stop_source stop;
+  stop.request_stop();
+  take(app->start(cancelledScene, cancelled, stop.get_token()));
+  check(take(app->step()).finished && cancelled.polls == 0 && cancelled.closes == 1 && cancelledScene.stops == 1);
+
+  ReadyTerminal later;
+  auto laterApp = take(Application::create({}, later.clock()));
+  Scene laterScene;
+  std::stop_source laterStop;
+  take(laterApp->start(laterScene, later, laterStop.get_token()));
+  take(laterApp->step());
+  laterStop.request_stop();
+  check(take(laterApp->step()).finished && later.polls == 1 && later.closes == 1 && laterScene.stops == 1);
+
+  ReadyTerminal callback;
+  auto nested = take(Application::create({}, callback.clock()));
+  Scene nestedScene;
+  nestedScene.reenter = nestedScene.stopOnInput = true;
+  take(nested->start(nestedScene, callback));
+  callback.bytes("x");
+  check(take(nested->step()).finished && nestedScene.rejections == 1 && callback.closes == 1);
+}
+
+void nativeTraceEquivalence() {
+  example::ReplayTerminal legacy({{50, "ab", {}}, {100, "c", CellSize{20, 4}}}, 200, {12, 3});
+  auto native = take(Application::create({}, legacy.clock()));
+  Scene nativeScene;
+  const auto nativeStats = take(native->run(nativeScene, legacy));
+  ReadyTerminal ready;
+  auto stepped = take(Application::create({}, ready.clock()));
+  Scene steppedScene;
+  take(stepped->start(steppedScene, ready));
+  ApplicationStep result;
+
+  for (ready.time = 10; ready.time <= 200; ready.time += 10) {
+    if (ready.time == 50) {
+      ready.bytes("ab");
+    } else if (ready.time == 100) {
+      ready.input.push_back({TerminalStatus::PROGRESS, "c", {}, CellSize{20, 4}});
+    } else if (ready.time == 200) {
+      ready.eof();
+    }
+
+    result = take(stepped->step());
+  }
+
+  check(result.finished && result.stats.inputs == nativeStats.inputs && result.stats.frames == nativeStats.frames);
+  check(result.stats.bytes == nativeStats.bytes && ready.output == legacy.output);
+  check(nativeScene.events.size() == steppedScene.events.size() && nativeScene.stops == steppedScene.stops);
+}
+} // namespace
+
+int main() {
+  idleAndLifecycle();
+  decoderAndBudget();
+  frameCapAndEofCutoff();
+  partialAndFailures();
+  cancellationAndDestruction();
+  nativeTraceEquivalence();
+}
diff --git a/tests/ui_session.cpp b/tests/ui_session.cpp
new file mode 100644
index 0000000..8c9d65b
--- /dev/null
+++ b/tests/ui_session.cpp
@@ -0,0 +1,314 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+#include "../examples/gallery/fluent_form.hpp"
+#include <portals/ui.hpp>
+
+#include <deque>
+#include <source_location>
+#include <stdexcept>
+#include <thread>
+
+namespace {
+using namespace portals;
+
+void check(bool value, std::source_location where = std::source_location::current()) {
+  if (!value) {
+    throw std::runtime_error("ui session check line " + std::to_string(where.line()));
+  }
+}
+
+template <class T, class E> T take(std::expected<T, E> value) {
+  check(bool(value));
+
+  if constexpr (!std::is_void_v<T>) {
+    return std::move(*value);
+  }
+}
+
+template <class T> void rejected(std::expected<T, ManagedError> value, TreeError cause) {
+  check(!value);
+
+  const auto *actual = std::get_if<TreeError>(&value.error().cause);
+
+  check(actual && *actual == cause);
+}
+
+void noCurrent() {
+  check(ui::detail::CurrentSceneScope::snapshot().expired());
+  rejected(ui::detail::SceneAccess::currentRef().quit(), TreeError::CLOSED);
+}
+
+class ReadyTerminal final : public ApplicationReadyTerminal {
+public:
+  SchedulerClock clock() noexcept {
+    return {[](void *context) noexcept {
+              return static_cast<ReadyTerminal *>(context)->time;
+            },
+            this};
+  }
+
+  TerminalRead poll(std::stop_token) override {
+    ++polls;
+
+    if (input.empty()) {
+      return {TerminalStatus::DEADLINE};
+    }
+
+    auto result = std::move(input.front());
+
+    input.pop_front();
+
+    return result;
+  }
+
+  std::expected<CellSize, TerminalError> size() const override {
+    return CellSize{80, 24};
+  }
+
+  std::expected<void, TerminalError> submit(std::string bytes) override {
+    check(pending.empty());
+    pending = std::move(bytes);
+    ++submissions;
+
+    return {};
+  }
+
+  TerminalWrite flushReady(std::stop_token) override {
+    const auto count = pending.size();
+
+    output += pending;
+    pending.clear();
+
+    return {TerminalStatus::PROGRESS, count, 0, {}};
+  }
+
+  std::expected<void, TerminalError> close() noexcept override {
+    ++closes;
+
+    if (failClose) {
+      return std::unexpected(TerminalError{TerminalErrorKind::SYSTEM, 17});
+    }
+
+    return {};
+  }
+
+  void bytes(std::string value) {
+    input.push_back({TerminalStatus::PROGRESS, std::move(value)});
+  }
+
+  SchedulerTime time{};
+  std::deque<TerminalRead> input;
+  std::string pending, output;
+  int polls{}, submissions{}, closes{};
+  bool failClose{};
+};
+
+ui::SceneOptions policies(ReadyTerminal &terminal) {
+  ui::SceneOptions result;
+
+  result.clock = terminal.clock();
+
+  return result;
+}
+
+void progressAndContext() {
+  ReadyTerminal terminal;
+  ui::Ref<Label> label;
+  auto scene = ui::scene(ui::label(label, "session"), policies(terminal));
+  ManagedScene *managed{};
+  int stops{}, keys{};
+
+  scene.configure([&](ManagedScene &owner) {
+    managed = &owner;
+  });
+  scene.onStop([&] {
+    ++stops;
+    noCurrent();
+    check(take(label.text().get()) == "session");
+  });
+  scene.onKey("q", [&] {
+    ++keys;
+    check(!ui::detail::CurrentSceneScope::snapshot().expired());
+    rejected(scene.step(), TreeError::WOULD_BLOCK);
+    rejected(managed->step(), TreeError::WOULD_BLOCK);
+    rejected(scene.start(terminal), TreeError::WOULD_BLOCK);
+    rejected(managed->start(terminal), TreeError::WOULD_BLOCK);
+    rejected(scene.close(), TreeError::WOULD_BLOCK);
+    rejected(managed->close(), TreeError::WOULD_BLOCK);
+    ui::quit();
+  });
+  rejected(scene.step(), TreeError::INVALID_ARGUMENT);
+  take(scene.start(terminal));
+  noCurrent();
+  rejected(scene.close(), TreeError::WOULD_BLOCK);
+  rejected(managed->close(), TreeError::WOULD_BLOCK);
+  rejected(scene.start(terminal), TreeError::WOULD_BLOCK);
+  check(!take(scene.step()).finished);
+  check(terminal.submissions == 1 && !terminal.output.empty());
+  check(!take(scene.step()).finished);
+  check(terminal.submissions == 1);
+  noCurrent();
+
+  std::thread worker([&] {
+    rejected(scene.step(), TreeError::WRONG_THREAD);
+    rejected(scene.start(terminal), TreeError::WRONG_THREAD);
+    rejected(managed->step(), TreeError::WRONG_THREAD);
+  });
+
+  worker.join();
+  terminal.bytes("q");
+
+  auto finished = take(scene.step());
+
+  check(finished.finished && stops == 1 && keys == 1 && terminal.closes == 1);
+  check(take(scene.step()).stats.iterations == finished.stats.iterations);
+  check(take(managed->step()).finished);
+  check(stops == 1 && terminal.closes == 1);
+  take(scene.checked());
+  take(scene.close());
+  rejected(scene.start(terminal), TreeError::CLOSED);
+  noCurrent();
+}
+
+void activeDestructionAndMove() {
+  ReadyTerminal terminal;
+  int stops{};
+
+  {
+    auto original = ui::scene(ui::label("move"), policies(terminal));
+
+    original.onStop([&] {
+      ++stops;
+      noCurrent();
+    });
+    take(original.start(terminal));
+    check(!take(original.step()).finished);
+
+    auto moved = std::move(original);
+
+    rejected(original.step(), TreeError::CLOSED);
+    check(!take(moved.step()).finished);
+    noCurrent();
+  }
+
+  check(stops == 1 && terminal.closes == 1);
+  noCurrent();
+
+  ReadyTerminal directTerminal;
+  auto app = take(Application::create({}, directTerminal.clock()));
+
+  {
+    auto managed = take(ManagedScene::create(*app));
+
+    take(managed->start(directTerminal));
+    check(!take(managed->step()).finished);
+  }
+
+  check(directTerminal.closes == 1);
+}
+
+void errorsAndCancellation() {
+  ReadyTerminal terminal;
+  int stops{}, reports{};
+  auto scene = ui::scene(ui::label("failure"), policies(terminal));
+
+  scene.onStop([&] {
+    ++stops;
+    noCurrent();
+  });
+  scene.onError([&](const ManagedDiagnostic &) {
+    ++reports;
+  });
+  scene.onKey("x", [] {
+    throw std::runtime_error("callback");
+  });
+  take(scene.start(terminal));
+  take(scene.step());
+  terminal.failClose = true;
+  terminal.bytes("x");
+
+  auto failed = scene.step();
+
+  check(!failed && reports == 1 && stops == 1 && terminal.closes == 1);
+  check(failed.error().application.has_value());
+  check(!scene.step() && reports == 1 && stops == 1 && terminal.closes == 1);
+  noCurrent();
+
+  ReadyTerminal cancelledTerminal;
+  std::stop_source cancellation;
+  int cancelledStops{};
+  auto cancelled = ui::scene(ui::label("cancelled"), policies(cancelledTerminal));
+
+  cancelled.onStop([&] {
+    ++cancelledStops;
+  });
+  cancellation.request_stop();
+  take(cancelled.start(cancelledTerminal, cancellation.get_token()));
+  check(take(cancelled.step()).finished);
+  check(cancelledStops == 1 && cancelledTerminal.closes == 1 && cancelledTerminal.polls == 0);
+}
+
+void setupAndPrepareFailures() {
+  for (const bool duringPrepare : {false, true}) {
+    ReadyTerminal terminal;
+    int stops{}, reports{};
+    auto description = ui::label("failure").onPrepare([](Label &, Node<Widget>) -> std::expected<void, TreeError> {
+      throw std::runtime_error("prepare");
+    });
+    auto scene = ui::scene(std::move(description), policies(terminal));
+
+    scene.onStop([&] {
+      ++stops;
+      noCurrent();
+    });
+    scene.onError([&](const ManagedDiagnostic &) {
+      ++reports;
+    });
+
+    if (!duringPrepare) {
+      scene.configure([](ManagedScene &) {
+        throw std::runtime_error("setup");
+      });
+    }
+
+    auto started = scene.start(terminal);
+
+    if (duringPrepare) {
+      take(started);
+
+      auto result = scene.step();
+
+      check(!result && stops == 1 && reports == 1 && terminal.closes == 1);
+      check(!scene.step() && reports == 1 && terminal.closes == 1);
+    } else {
+      check(!started && stops == 1 && reports == 1 && terminal.closes == 0);
+      check(!scene.step() && !scene.start(terminal));
+      check(stops == 1 && reports == 1 && terminal.closes == 0);
+    }
+
+    noCurrent();
+  }
+}
+
+void galleryReuse() {
+  ReadyTerminal terminal;
+  example::Options options;
+  auto scene = gallery::form(ui::OptionsRef(options), {}, policies(terminal));
+
+  take(scene.start(terminal));
+  check(!take(scene.step()).finished);
+  check(terminal.output.find("Portals gallery") != std::string::npos);
+  terminal.bytes("\x1b[21~");
+  check(take(scene.step()).finished);
+  check(terminal.closes == 1);
+  noCurrent();
+}
+} // namespace
+
+int main() {
+  progressAndContext();
+  activeDestructionAndMove();
+  errorsAndCancellation();
+  setupAndPrepareFailures();
+  galleryReuse();
+}
