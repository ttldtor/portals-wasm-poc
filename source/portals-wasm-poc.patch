index 0000000..33e3cd1
--- /dev/null
+++ b/examples/wasm_gallery/browser_terminal.cpp
@@ -0,0 +1,177 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+#include "browser_terminal.hpp"
+
+#include <utility>
+
+namespace wasm_gallery {
+using namespace portals;
+
+std::expected<std::unique_ptr<BrowserTerminal>, TerminalError>
+BrowserTerminal::create(CellSize size, Sink sink, TerminalOptions options) {
+  if (size.width < 0 || size.height < 0 || !sink || options.max_input_bytes == 0 || options.max_output_bytes == 0) {
+    return std::unexpected(TerminalError{TerminalErrorKind::INVALID_OPTIONS});
+  }
+
+  return std::unique_ptr<BrowserTerminal>(new BrowserTerminal(size, std::move(sink), options));
+}
+
+BrowserTerminal::BrowserTerminal(CellSize size, Sink sink, TerminalOptions options)
+    : size_(size), sink_(std::move(sink)), maxInputBytes_(options.max_input_bytes),
+      maxOutputBytes_(options.max_output_bytes) {
+}
+
+std::optional<TerminalError> BrowserTerminal::operationError() const noexcept {
+  if (closed_) {
+    return TerminalError{TerminalErrorKind::CLOSED};
+  }
+
+  return failure_;
+}
+
+std::expected<void, TerminalError> BrowserTerminal::pushInput(std::string_view bytes) {
+  if (const auto error = operationError()) {
+    return std::unexpected(*error);
+  }
+
+  if (bytes.size() > maxInputBytes_ - input_.size()) {
+    return recordFailure({TerminalErrorKind::INPUT_LIMIT});
+  }
+
+  input_.append(bytes);
+
+  return {};
+}
+
+std::expected<void, TerminalError> BrowserTerminal::resize(CellSize size) {
+  if (const auto error = operationError()) {
+    return std::unexpected(*error);
+  }
+
+  if (size.width < 0 || size.height < 0) {
+    return recordFailure({TerminalErrorKind::INVALID_OPTIONS});
+  }
+
+  if (size != size_) {
+    size_ = size;
+    resized_ = size;
+  }
+
+  return {};
+}
+
+std::expected<void, TerminalError> BrowserTerminal::recordFailure(TerminalError error) {
+  if (const auto current = operationError()) {
+    return std::unexpected(*current);
+  }
+
+  failure_ = error;
+
+  return std::unexpected(error);
+}
+
+TerminalRead BrowserTerminal::poll(std::stop_token stop) {
+  if (const auto error = operationError()) {
+    return {TerminalStatus::FAILED, {}, {}, {}, *error};
+  }
+
+  if (stop.stop_requested()) {
+    return {TerminalStatus::STOPPED};
+  }
+
+  if (input_.empty() && !resized_) {
+    return {TerminalStatus::DEADLINE};
+  }
+
+  TerminalRead result;
+
+  result.bytes.swap(input_);
+  result.resized = std::exchange(resized_, std::nullopt);
+
+  return result;
+}
+
+std::expected<CellSize, TerminalError> BrowserTerminal::size() const {
+  if (const auto error = operationError()) {
+    return std::unexpected(*error);
+  }
+
+  return size_;
+}
+
+std::expected<void, TerminalError> BrowserTerminal::submit(std::string bytes) {
+  if (const auto error = operationError()) {
+    return std::unexpected(*error);
+  }
+
+  if (pendingBytes() != 0) {
+    return std::unexpected(TerminalError{TerminalErrorKind::OUTPUT_PENDING});
+  }
+
+  if (bytes.size() > maxOutputBytes_) {
+    return std::unexpected(TerminalError{TerminalErrorKind::OUTPUT_LIMIT});
+  }
+
+  output_ = std::move(bytes);
+  outputOffset_ = 0;
+
+  return {};
+}
+
+TerminalWrite BrowserTerminal::flushReady(std::stop_token stop) {
+  if (const auto error = operationError()) {
+    return {TerminalStatus::FAILED, 0, pendingBytes(), *error};
+  }
+
+  if (stop.stop_requested()) {
+    return {TerminalStatus::STOPPED, 0, pendingBytes()};
+  }
+
+  if (pendingBytes() == 0) {
+    return {};
+  }
+
+  const auto suffix = std::string_view(output_).substr(outputOffset_);
+  std::expected<std::size_t, TerminalError> accepted;
+
+  try {
+    accepted = sink_(suffix);
+  } catch (...) {
+    accepted = std::unexpected(TerminalError{TerminalErrorKind::OUTPUT_UNCERTAIN});
+  }
+
+  if (!accepted || *accepted > suffix.size()) {
+    const auto error = accepted ? TerminalError{TerminalErrorKind::OUTPUT_UNCERTAIN} : accepted.error();
+
+    failure_ = error;
+
+    return {TerminalStatus::FAILED, 0, pendingBytes(), error};
+  }
+
+  outputOffset_ += *accepted;
+
+  const auto remaining = pendingBytes();
+
+  if (remaining == 0) {
+    output_.clear();
+    outputOffset_ = 0;
+  }
+
+  return {remaining == 0 ? TerminalStatus::PROGRESS : TerminalStatus::DEADLINE, *accepted, remaining};
+}
+
+std::size_t BrowserTerminal::pendingBytes() const noexcept {
+  return output_.size() - outputOffset_;
+}
+
+std::expected<void, TerminalError> BrowserTerminal::close() noexcept {
+  closed_ = true;
+  input_.clear();
+  output_.clear();
+  outputOffset_ = 0;
+  resized_.reset();
+  failure_.reset();
+
+  return {};
+}
+} // namespace wasm_gallery
diff --git a/examples/wasm_gallery/browser_terminal.hpp b/examples/wasm_gallery/browser_terminal.hpp
new file mode 100644
index 0000000..50d57c1
--- /dev/null
+++ b/examples/wasm_gallery/browser_terminal.hpp
@@ -0,0 +1,90 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+#pragma once
+
+#include <portals/application.hpp>
+
+#include <functional>
+#include <string_view>
+
+namespace wasm_gallery {
+
+/** @brief Bounded single-UI-thread transport for a browser host, with no waits or implicit output.
+ * All calls, including host delivery and destruction, require the same thread and must not reenter.
+ * Input and output own their bytes. No JavaScript or WASM heap pointer is retained by this adapter.
+ * Allocation failures may throw. The first host/sink failure is retained until close; failed output is never retried.
+ */
+class BrowserTerminal final : public portals::ApplicationReadyTerminal {
+public:
+  /** @brief Synchronous nonblocking byte acceptance function.
+   * @param bytes Borrowed unsent suffix, valid only during this invocation. Copy every accepted byte before returning.
+   * @return Accepted prefix length, zero for backpressure, or an original transport failure.
+   * Must return promptly without waiting for display completion and must not reenter this transport.
+   * An exception or a count larger than bytes.size() makes output uncertain and permanently fails the transport.
+   */
+  using Sink = std::function<std::expected<std::size_t, portals::TerminalError>(std::string_view bytes)>;
+
+  /** @brief Validate and create an exclusive transport without performing host I/O.
+   * @param size Initial nonnegative cell viewport; zero dimensions are supported.
+   * @param sink Owning callback; captured borrowed state must survive close. An empty callback is invalid.
+   * @param options Positive max_input_bytes and max_output_bytes queue limits; native-only fields are unused.
+   * @return Owner, or INVALID_OPTIONS for an invalid viewport, callback or relevant limit.
+   */
+  static std::expected<std::unique_ptr<BrowserTerminal>, portals::TerminalError>
+  create(portals::CellSize size, Sink sink, portals::TerminalOptions options = {});
+  ~BrowserTerminal() override = default;                        ///< Release storage without emitting terminal commands.
+  BrowserTerminal(const BrowserTerminal &) = delete;            ///< Exclusive input/output state cannot be copied.
+  BrowserTerminal &operator=(const BrowserTerminal &) = delete; ///< Exclusive state cannot be assigned.
+
+  /** @brief Copy host bytes into the bounded input queue without decoding or running the application.
+   * @param bytes Borrowed fragment, including incomplete UTF-8 or escape sequences; empty is allowed.
+   * @return Success, CLOSED, retained first failure, or a sticky INPUT_LIMIT failure without partial admission.
+   */
+  std::expected<void, portals::TerminalError> pushInput(std::string_view bytes);
+  /** @brief Coalesce host resize notifications without running the application.
+   * @param size New nonnegative viewport; zero dimensions are supported.
+   * @return Success, CLOSED, retained failure, or sticky INVALID_OPTIONS for negative dimensions.
+   */
+  std::expected<void, portals::TerminalError> resize(portals::CellSize size);
+  /** @brief Retain the first asynchronous host error for the next ready operation.
+   * @param error Owning original bridge error; never replaces an earlier error.
+   * @return The retained failure, or CLOSED after close; always an unexpected result.
+   */
+  std::expected<void, portals::TerminalError> recordFailure(portals::TerminalError error);
+  /** @param stop Cancellation signal; stopped polls do not consume input or resize.
+   * @return One owning batch, DEADLINE when empty, STOPPED, or the retained failure.
+   */
+  portals::TerminalRead poll(std::stop_token stop = {}) override;
+  /** @return Latest viewport, CLOSED or retained failure; does not consume resize notifications. */
+  std::expected<portals::CellSize, portals::TerminalError> size() const override;
+  /** @param bytes Complete owning transaction; no sink invocation occurs here.
+   * @return Success, CLOSED, retained failure, OUTPUT_PENDING, or OUTPUT_LIMIT; rejected batches are not retained.
+   */
+  std::expected<void, portals::TerminalError> submit(std::string bytes) override;
+  /** @param stop Cancellation signal; a stopped flush preserves the unsent suffix.
+   * @return One sink invocation's exact acceptance; DEADLINE while pending, PROGRESS when complete, or failure.
+   */
+  portals::TerminalWrite flushReady(std::stop_token stop = {}) override;
+  /** @return Unaccepted bytes still owned, including a failed transaction; zero after close. */
+  std::size_t pendingBytes() const noexcept;
+  /** @brief Discard queues and close once, without emitting clear/restoration bytes or calling the sink.
+   * @return Success, including repeated close; the last host picture remains visible.
+   */
+  std::expected<void, portals::TerminalError> close() noexcept override;
+
+private:
+  BrowserTerminal(portals::CellSize size, Sink sink, portals::TerminalOptions options);
+  std::optional<portals::TerminalError> operationError() const noexcept;
+
+  portals::CellSize size_;
+  Sink sink_;
+  std::size_t maxInputBytes_;
+  std::size_t maxOutputBytes_;
+  std::string input_;
+  std::string output_;
+  std::size_t outputOffset_{};
+  std::optional<portals::CellSize> resized_;
+  std::optional<portals::TerminalError> failure_;
+  bool closed_{};
+};
+} // namespace wasm_gallery
diff --git a/examples/wasm_gallery/main.cpp b/examples/wasm_gallery/main.cpp
new file mode 100644
index 0000000..631f250
--- /dev/null
+++ b/examples/wasm_gallery/main.cpp
@@ -0,0 +1,150 @@
+// Copyright (c) 2026 ttldtor.
+// SPDX-License-Identifier: BSL-1.0
+#include "../gallery/fluent_form.hpp"
+#include "browser_terminal.hpp"
+
+#include <emscripten.h>
+#include <format>
+
+namespace {
+EM_JS(int, writeHost, (const char *bytes, std::size_t length), {
+  try {
+    return Module['portalsWrite'](HEAPU8.subarray(bytes, bytes + length));
+  } catch (failure) {
+    console.error(failure);
+    return -1;
+  }
+});
+
+struct BrowserApplication {
+  example::Options options;
+  std::unique_ptr<wasm_gallery::BrowserTerminal> terminal;
+  portals::ui::Scene scene = gallery::form(portals::ui::opts(options));
+};
+
+// Member order keeps settings and transport alive while Scene finishes its session.
+std::unique_ptr<BrowserApplication> application;
+std::string lastError;
+
+int fail(std::string message) {
+  lastError = std::move(message);
+
+  return -1;
+}
+
+int managedFailure(std::string_view operation, const portals::ManagedError &error) {
+  return fail(std::format("{} failed (phase {}, cause {}).", operation, static_cast<int>(error.phase),
+                          error.cause.index()));
+}
+} // namespace
+
+extern "C" {
+/** @param columns Initial terminal width in cells.
+ * @param rows Initial terminal height in cells.
+ * @return Zero after starting, or minus one with an owning error string.
+ */
+EMSCRIPTEN_KEEPALIVE int portals_start(int columns, int rows) {
+  if (application) {
+    return fail("The gallery is already running. Reload the page to restart.");
+  }
+
+  try {
+    auto owner = std::make_unique<BrowserApplication>();
+    auto terminal = wasm_gallery::BrowserTerminal::create({columns, rows}, [](std::string_view bytes) -> std::expected<std::size_t, portals::TerminalError> {
+      const auto accepted = writeHost(bytes.data(), bytes.size());
+
+      if (accepted < 0) {
+        return std::unexpected(portals::TerminalError{portals::TerminalErrorKind::OUTPUT_UNCERTAIN});
+      }
+
+      return static_cast<std::size_t>(accepted);
+    });
+
+    if (!terminal) {
+      return fail("Cannot create the browser terminal.");
+    }
+
+    owner->terminal = std::move(*terminal);
+    application = std::move(owner);
+
+    auto started = application->scene.start(*application->terminal);
+
+    if (!started) {
+      return managedFailure("Gallery startup", started.error());
+    }
+
+    return 0;
+  } catch (const std::exception &error) {
+    return fail(error.what());
+  } catch (...) {
+    return fail("Unknown gallery startup failure.");
+  }
+}
+
+/** @return Zero to continue, one after cleanup, or minus one after a reported failure. */
+EMSCRIPTEN_KEEPALIVE int portals_step() {
+  if (!application) {
+    return fail("The gallery has not started.");
+  }
+
+  try {
+    auto step = application->scene.step();
+
+    if (!step) {
+      return managedFailure("Gallery step", step.error());
+    }
+
+    return step->finished ? 1 : 0;
+  } catch (const std::exception &error) {
+    return fail(error.what());
+  } catch (...) {
+    return fail("Unknown gallery step failure.");
+  }
+}
+
+/** @param bytes Borrowed UTF-8 bytes, copied before return.
+ * @param length Byte count, including incomplete sequences.
+ * @return Zero after admission, or minus one after a visible transport error.
+ */
+EMSCRIPTEN_KEEPALIVE int portals_input(const char *bytes, std::size_t length) {
+  if (!application) {
+    return fail("The gallery is closed.");
+  }
+
+  try {
+    auto pushed = application->terminal->pushInput({bytes, length});
+
+    return pushed ? 0 : fail("Terminal input failed or exceeded its queue limit.");
+  } catch (...) {
+    return fail("Cannot retain terminal input.");
+  }
+}
+
+/** @param columns New nonnegative terminal width in cells.
+ * @param rows New nonnegative terminal height in cells.
+ * @return Zero after admission, or minus one after a viewport error.
+ */
+EMSCRIPTEN_KEEPALIVE int portals_resize(int columns, int rows) {
+  if (!application) {
+    return fail("The gallery is closed.");
+  }
+
+  auto resized = application->terminal->resize({columns, rows});
+
+  return resized ? 0 : fail("Terminal resize failed.");
+}
+
+/** @return Borrowed null-terminated diagnostic, valid until the next failed export call. */
+EMSCRIPTEN_KEEPALIVE const char *portals_error() {
+  return lastError.c_str();
+}
+
+/** @brief Release the scene before its transport and options, after leaving the current step. */
+EMSCRIPTEN_KEEPALIVE void portals_shutdown() {
+  application.reset();
+}
+}
+
+int main() {
+  return 0;
+}
